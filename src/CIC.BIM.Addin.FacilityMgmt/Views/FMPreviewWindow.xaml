<Window x:Class="CIC.BIM.Addin.FacilityMgmt.Views.FMPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏗 Quản lý Vận hành — Thiết bị Tài sản"
        Width="1200" Height="780" MinWidth="950" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E" Foreground="#CDD6F4">

    <Window.Resources>
        <ResourceDictionary Source="../Themes/ToolStyles.xaml"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0: HEADER ═══ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <DockPanel>
                <Border x:Name="BadgeFM" Style="{StaticResource DeptBadge}" Background="#1A3A2A" DockPanel.Dock="Right">
                    <TextBlock x:Name="TxtBadge" Text="Vận hành" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}"/>
                </Border>
                <TextBlock Text="🏗 Quản lý Vận hành — Thiết bị Tài sản" FontSize="18" FontWeight="Bold"/>
            </DockPanel>
            <TextBlock Text="Xem xét danh sách thiết bị MEP trước khi gán tham số quản lý vận hành"
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
            <Border Height="2" Background="{StaticResource GreenBrush}" Margin="0,10,0,0" Opacity="0.4"/>
        </StackPanel>

        <!-- ═══ ROW 1: STATS BADGES ═══ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📊" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <!-- Total devices -->
                <Border Background="#233A5C" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtTotalDevices" Text="0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
                        <TextBlock Text=" thiết bị" FontSize="11" Foreground="{StaticResource TextSecBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Categories count -->
                <Border Background="#3A2A1E" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtCategoryCount" Text="0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AmberBrush}"/>
                        <TextBlock Text=" loại" FontSize="11" Foreground="{StaticResource TextSecBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Levels count -->
                <Border Background="#1A3A3A" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtLevelCount" Text="0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"/>
                        <TextBlock Text=" tầng" FontSize="11" Foreground="{StaticResource TextSecBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Assigned count -->
                <Border Background="#3A1A2A" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtAssignedCount" Text="0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource RedBrush}"/>
                        <TextBlock Text=" chưa gán" FontSize="11" Foreground="{StaticResource TextSecBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══ ROW 2: FILTER BAR ═══ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10">
            <DockPanel>
                <!-- Right: Load button -->
                <Button x:Name="BtnLoad" Content="▶ Tải dữ liệu" Style="{StaticResource PrimaryButton}"
                        DockPanel.Dock="Right" Click="BtnLoad_Click" Margin="12,0,0,0" Padding="16,6"/>

                <WrapPanel VerticalAlignment="Center">
                    <!-- Category filter -->
                    <TextBlock Text="Phân loại:" FontSize="12" Foreground="{StaticResource TextSecBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CboCategory" Width="150" FontSize="12"
                              Style="{StaticResource DarkComboBox}"
                              SelectionChanged="CboFilter_SelectionChanged"/>

                    <!-- Level filter -->
                    <TextBlock Text="Tầng:" FontSize="12" Foreground="{StaticResource TextSecBrush}"
                               VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <ComboBox x:Name="CboLevel" Width="130" FontSize="12"
                              Style="{StaticResource DarkComboBox}"
                              SelectionChanged="CboFilter_SelectionChanged"/>

                    <!-- Only unassigned checkbox -->
                    <CheckBox x:Name="ChkOnlyUnassigned" Content="Chỉ chưa gán FM" FontSize="12"
                              Foreground="{StaticResource TextBrush}" Margin="16,0,0,0"
                              VerticalAlignment="Center"
                              Checked="ChkOnlyUnassigned_Changed" Unchecked="ChkOnlyUnassigned_Changed"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ═══ ROW 3: SEARCH BAR ═══ -->
        <Border Grid.Row="3" Background="#313244" CornerRadius="6" Padding="8,6" Margin="0,0,0,0">
            <DockPanel>
                <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtSearch" Style="{StaticResource DarkTextBox}"
                         FontSize="12" Background="Transparent" BorderThickness="0"
                         TextChanged="TxtSearch_TextChanged">
                    <TextBox.Tag>Tìm kiếm nhanh (theo tên, family, vị trí...)</TextBox.Tag>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- ═══ ROW 4: DATAGRID ═══ -->
        <DataGrid x:Name="DgDevices" Grid.Row="4" Margin="0,8,0,0"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserSortColumns="True" CanUserReorderColumns="True"
                  Background="#313244" Foreground="#CDD6F4"
                  GridLinesVisibility="All" HorizontalGridLinesBrush="#45475A" VerticalGridLinesBrush="#3B3D50"
                  BorderBrush="#45475A" BorderThickness="1"
                  RowBackground="#313244" AlternatingRowBackground="#3B3D50"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  HeadersVisibility="Column" ColumnHeaderHeight="34"
                  IsReadOnly="True">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1A3A2A"/>
                    <Setter Property="Foreground" Value="#A6E3A1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderBrush" Value="#45475A"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="#CDD6F4"/>
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="Padding" Value="6,3"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#45475A"/>
                            <Setter Property="Foreground" Value="#A6E3A1"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#45475A"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Tên thiết bị" Binding="{Binding [Tên thiết bị]}" Width="180"/>
                <DataGridTextColumn Header="Family" Binding="{Binding [Family]}" Width="150"/>
                <DataGridTextColumn Header="Type" Binding="{Binding [Type]}" Width="130"/>
                <DataGridTextColumn Header="Phân loại FM" Binding="{Binding [Phân loại FM]}" Width="120"/>
                <DataGridTextColumn Header="Tầng" Binding="{Binding [Tầng]}" Width="90"/>
                <DataGridTextColumn Header="Vị trí" Binding="{Binding [Vị trí]}" Width="160"/>
                <DataGridTextColumn Header="Mã tài sản" Binding="{Binding [Mã tài sản]}" Width="120"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding [Trạng thái]}" Width="90"/>
                <DataGridTextColumn Header="Tình trạng" Binding="{Binding [Tình trạng]}" Width="90"/>
                <DataGridTextColumn Header="FM" Binding="{Binding [Đã gán FM]}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══ ROW 5: STATUS BAR ═══ -->
        <Border Grid.Row="5" Background="#1E1E2E" Padding="8" Margin="0,8,0,0" CornerRadius="6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="Đã chọn:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxtSelectedCount" Text="0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text=" / " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtVisibleCount" Text="0" FontSize="11" Foreground="{StaticResource TextSecBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TxtStatus" FontSize="11.5" Foreground="{StaticResource TextSecBrush}"
                           VerticalAlignment="Center" Text="Nhấn ▶ Tải dữ liệu để bắt đầu."/>
            </DockPanel>
        </Border>

        <!-- ═══ ROW 6: FOOTER ACTIONS ═══ -->
        <DockPanel Grid.Row="6" Margin="0,12,0,0">
            <Button x:Name="BtnClose" Content="Đóng" Style="{StaticResource SecondaryButton}"
                    DockPanel.Dock="Right" Click="BtnClose_Click" Margin="8,0,0,0"/>

            <Button x:Name="BtnAssignParams" Content="⚙ Gán tham số FM" Style="{StaticResource PrimaryButton}"
                    DockPanel.Dock="Right" Click="BtnAssignParams_Click" IsEnabled="False" Margin="8,0,0,0"/>

            <Button x:Name="BtnExportExcel" Content="📊 Xuất Excel" Style="{StaticResource SecondaryButton}"
                    DockPanel.Dock="Right" Click="BtnExportExcel_Click" IsEnabled="False" Margin="8,0,0,0"/>

            <Button x:Name="BtnAutoFill" Content="🔄 Tự động điền" Style="{StaticResource SecondaryButton}"
                    DockPanel.Dock="Right" Click="BtnAutoFill_Click" IsEnabled="False" Margin="8,0,0,0"/>

            <Button x:Name="BtnSelectAll" Content="☑ Chọn tất cả" Style="{StaticResource SecondaryButton}"
                    DockPanel.Dock="Left" Click="BtnSelectAll_Click" IsEnabled="False" Padding="14,6" FontSize="11"/>

            <Button x:Name="BtnSelectNone" Content="☐ Bỏ chọn" Style="{StaticResource SecondaryButton}"
                    DockPanel.Dock="Left" Click="BtnSelectNone_Click" IsEnabled="False" Padding="14,6" FontSize="11" Margin="6,0,0,0"/>
        </DockPanel>
    </Grid>
</Window>
