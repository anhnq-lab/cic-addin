<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CIC.BIM.Addin.FacilityMgmt</RootNamespace>
    <AssemblyName>CIC.BIM.Addin.FacilityMgmt</AssemblyName>
    <NoWarn>$(NoWarn);NU1605</NoWarn>
  </PropertyGroup>

  <!-- ClosedXML for Excel export — version-conditional for framework compat -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="ClosedXML" Version="0.102.3" />
  </ItemGroup>

  <!-- WinForms for SaveFileDialog in Revit context -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>

  <!-- Embed shared parameter file -->
  <ItemGroup>
    <EmbeddedResource Include="FMSharedParamFile.txt" />
  </ItemGroup>
  <!-- Reference CIC.BIM.Addin.Tools for AuthGuard -->
  <ItemGroup>
    <ProjectReference Include="..\CIC.BIM.Addin.Tools\CIC.BIM.Addin.Tools.csproj">
      <Private>false</Private>
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
